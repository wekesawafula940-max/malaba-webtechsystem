# Daraja app credentials from Safaricom Developer Portal. Never commit a populated .env file.
SAFARICOM_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_PARTY_B=
# Must be a public HTTPS endpoint pointing to /api/payments/daraja/callback.
DARAJA_CALLBACK_URL=
# CustomerPayBillOnline for a PayBill shortcode; CustomerBuyGoodsOnline for a Till.
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
# Required only during first-admin setup in production.
ADMIN_SETUP_KEY=
